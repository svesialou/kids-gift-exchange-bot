TELEGRAM_BOT_TOKEN=
# Telegram user ids of organizers, comma separated.
ADMIN_IDS=
# Optional: when set, new users must open t.me/<bot>?start=<INVITE_CODE>.
INVITE_CODE=
# Public HTTPS address of the admin Mini App; empty disables the panel and its HTTP server.
WEBAPP_URL=
HTTP_ADDR=127.0.0.1:18090

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kids_gift_exchange
DB_USER=kids_gift_exchange
DB_PASSWORD=

TIMEZONE=Europe/Minsk
# Defaults only: organizers change these per exchange in the admin panel.
GIFT_BUDGET_MAX=25
GIFT_CURRENCY=BYN
ORDER_DEADLINE=13.12
DELIVERY_DEADLINE=25.12

MORNING_HOUR=10
EVENING_HOUR=19
QUIET_HOUR=22
CODE_PENDING_REMINDER_AFTER=2h
STUCK_AFTER=96h
SCHEDULER_INTERVAL=10m
